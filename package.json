{
  "name": "house-shop-admin",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@agentshouse/app-bridge": "0.1.0-cc70c9b07c3ec",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/quicksand": "^5.2.8",
    "@fontsource/roboto": "^5.2.8",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@tanstack/react-query": "^5.101.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dompurify": "^3.4.0",
    "echarts": "^6.1.0",
    "inflection": "^3.0.0",
    "query-string": "^7.1.3",
    "ra-i18n-polyglot": "^5.0.0",
    "ra-input-rich-text": "^5.0.0",
    "ra-language-english": "^5.0.0",
    "ra-language-french": "^5.0.0",
    "react": "^19.0.0",
    "react-admin": "^5.0.0",
    "react-dom": "^19.0.0",
    "react-router": "7.18.2",
    "react-router-dom": "7.18.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts *.ts",
    "test": "vitest run",
    "prebuild": "node scripts/prepare-release.mjs",
    "release:check": "node scripts/check-release.mjs && npm run test:startup",
    "notices": "node scripts/generate-notices.mjs",
    "test:startup": "node --experimental-vm-modules --disallow-code-generation-from-strings --frozen-intrinsics scripts/check-sandbox-startup.mjs",
    "publish": "node publish.mjs",
    "verify": "npm run typecheck && npm run lint && npm test -- --maxWorkers=2 && npm run build && npm run release:check && node scripts/check-release.mjs --self-test && node scripts/generate-notices.mjs --check && npm run starter:check",
    "starter:check": "node scripts/check-starter.mjs"
  },
  "devDependencies": {
    "@agentshouse/mdmodel": "0.1.0-c68e2039f1ca8",
    "@agentshouse/mdruntime": "0.1.0-c8ca66ac9e99d",
    "@eslint/js": "^9.22.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.19.19",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "6.2.5",
    "globals": "^16.3.0",
    "happy-dom": "^20.14.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.0"
  },
  "license": "MIT"
}
